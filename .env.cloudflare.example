# Cloudflare + Docker + Nginx deployment environment
NODE_ENV=production
PORT=3000
DB_PATH=/app/data/bd-ticketpro.db

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=StrongPassword!2026
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=+1234567890

ALLOWED_ORIGINS=https://your-domain.com
ALLOW_DEMO_USERS=false

# Nginx certificates are mounted from a local certs directory.
# Put your cert files in ./certs/
# fullchain.pem
# privkey.pem
