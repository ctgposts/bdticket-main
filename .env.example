# =========================================
# Production environment example
# Copy this file to .env.production or set
# these variables in your deployment platform.
# =========================================

NODE_ENV=production
PORT=3000

# Database
# For SQLite in production, keep the DB in a persistent volume or directory.
DB_PATH=/var/www/bdticketpro/data/bd-ticketpro.db

# JWT
# Use a long random secret in production.
JWT_SECRET=replace_with_a_long_random_secret_32_chars_plus
JWT_EXPIRES_IN=7d

# Admin bootstrap credentials
# Only used when no users exist and production mode is active.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword123!
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=+1234567890

# Allowed origins for CORS
# Add your real deployed frontend URL(s), comma-separated.
ALLOWED_ORIGINS=https://your-domain.com

# Demo users toggle
# Keep this false in production.
ALLOW_DEMO_USERS=false

# Optional app settings
COMPANY_NAME=BD TicketPro
COMPANY_EMAIL=info@yourdomain.com
COMPANY_PHONE=+880-123-456-7890
COMPANY_ADDRESS=Dhanmondi, Dhaka, Bangladesh
DEFAULT_CURRENCY=BDT
TIMEZONE=Asia/Dhaka
